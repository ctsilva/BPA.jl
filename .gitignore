# Julia
Manifest.toml
*.jl.cov
*.jl.*.cov
*.jl.mem
.julia/
docs/build/

# Reconstruction outputs (regenerable, see results/README.md)
results/*
!results/README.md

# Downloaded Stanford data and everything the scripts derive from it
# (scripts/download_*.sh and scripts/convert_*_scans.sh recreate them)
data/bunny/
data/dragon/
data/*_bpa*.off
data/*-julia.off

# Intermediates of the convert scripts, wherever they are run
*_colored.ply
*_xformed.ply
combined.ply

# Editors and OS
.DS_Store
.vscode/
*.swp
*~

# Comparison harness (see compare/README.md): the Python environment uv creates, and the
# regenerable bulk of the results (meshes, difference lists, generated inputs). The reports,
# logs and renderings under compare/results/ are kept, so the comparison reads on GitHub.
compare/.venv/
compare/__pycache__/
compare/results/**/*.off
compare/results/**/only_in_*.txt
compare/results/inputs/
compare/results/regen.log
